CHESS_CRAWL_CONTACT="you@example.com"
# Optional: override the generated User-Agent entirely.
CHESS_CRAWL_USER_AGENT=""
# Optional: public Lichess API token for the operator's own account limits.
CHESS_CRAWL_LICHESS_TOKEN=""
# Retain optional provider analysis data when available. Set individual fields
# to false to omit them from subsequent game requests.
CHESS_CRAWL_LICHESS_CLOCKS=true
CHESS_CRAWL_LICHESS_EVALS=true
CHESS_CRAWL_LICHESS_ACCURACY=true
