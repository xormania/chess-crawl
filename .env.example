# The default Compose stack uses its private PostgreSQL service and an explicit
# local transport policy. To use an external server, also select the overlay:
# docker compose -f compose.yaml -f compose.external.yaml up --build -d --wait
CHESS_CRAWL_DATABASE_URL="postgresql://chess_crawl@postgres:5432/chess_crawl"
# External mode requires a password-free URL for that server and its CA PEM file:
# CHESS_CRAWL_DATABASE_URL="postgresql://chess_crawl@database.example:5432/chess_crawl"
# CHESS_CRAWL_DATABASE_CA_FILE="./data/dev-secrets/postgres_ca.pem"
# Supply that server's password in data/dev-secrets/postgres_password. Bootstrap
# preserves an existing valid password file. Do not place passwords in the URL.
# The external overlay forces verified TLS and mounts the CA certificate.
#
# Source-run clients default to verified TLS. Configure a CA with
# CHESS_CRAWL_DATABASE_SSL_ROOT_CERT_FILE and select exactly one password source:
# CHESS_CRAWL_DATABASE_PASSWORD_FILE or CHESS_CRAWL_DATABASE_PASSWORD.
# CHESS_CRAWL_DATABASE_TRANSPORT=local is an explicit exception for Unix sockets
# and loopback servers. The default Compose stack trusts only its postgres host.

CHESS_CRAWL_CONTACT="you@example.com"
# Optional: override the generated User-Agent entirely.
CHESS_CRAWL_USER_AGENT=""
# Optional: public Lichess API token for the operator's own account limits.
CHESS_CRAWL_LICHESS_TOKEN=""
# Workspace owning the optional provider token; private team reads require this match.
CHESS_CRAWL_LICHESS_TOKEN_OWNER_SCOPE=local
# Retain optional provider analysis data when available. Set individual fields
# to false to omit them from subsequent game requests.
CHESS_CRAWL_LICHESS_CLOCKS=true
CHESS_CRAWL_LICHESS_EVALS=true
CHESS_CRAWL_LICHESS_ACCURACY=true

# Raw body storage: database keeps existing behavior. Local/S3 modes retain
# immutable gzip backups and store verified references in PostgreSQL. Existing
# inline bodies move only through the operational archive migration helper.
# These variables configure source-run clients and operational helpers.
# Compose explicitly selects local mode at /var/lib/chess-crawl/archive and its
# persistent archive_data volume; it does not override that mode from .env.
# Its image includes the S3 extra. The AWS template explicitly selects S3 mode.
# See docs/archive-storage.md and docs/aws-deployment.md for deployment settings.
CHESS_CRAWL_ARCHIVE_BACKEND=database
# Local mode requires an explicit absolute directory on durable shared storage.
# CHESS_CRAWL_ARCHIVE_DIRECTORY="/absolute/path/to/archive"
# S3 mode requires the s3 extra and the normal AWS credential provider chain.
# CHESS_CRAWL_ARCHIVE_S3_BUCKET="your-private-archive-bucket"
CHESS_CRAWL_MAX_WORKING_SET_MEMBERS=10000
# Emit anonymous workload durations, byte counts, logical object operations and
# deduplication outcomes as JSON lines. Billing estimates use supplied prices.
CHESS_CRAWL_USAGE_LOG=false

# Trusted run/workspace quotas; HTTP clients cannot override these ceilings.
CHESS_CRAWL_JOB_MAX_GAMES=100000
CHESS_CRAWL_JOB_MAX_NORMALIZATION_UNITS=100000
CHESS_CRAWL_JOB_MAX_REMOTE_BYTES=268435456
CHESS_CRAWL_JOB_MAX_REMOTE_REQUESTS=2000
CHESS_CRAWL_MAX_RESPONSE_BYTES=16777216
CHESS_CRAWL_WORKSPACE_MAX_GAMES=1000000
CHESS_CRAWL_WORKSPACE_MAX_NORMALIZATION_UNITS=1000000
CHESS_CRAWL_WORKSPACE_MAX_REMOTE_BYTES=2147483648
CHESS_CRAWL_WORKSPACE_MAX_REMOTE_REQUESTS=10000
CHESS_CRAWL_WORKSPACE_MAX_ACTIVE_JOBS=2
CHESS_CRAWL_WORKSPACE_MAX_QUEUED_JOBS=32

# Export storage is retained until download close/expiry. These caps are per API
# process; budget OUTSTANDING_BYTES x workers x replicas plus application memory.
# Compose uses one API process with memory-backed /tmp.
CHESS_CRAWL_EXPORT_MAX_ROWS=100000
CHESS_CRAWL_EXPORT_MAX_BYTES=67108864
CHESS_CRAWL_EXPORT_PREPARE_SECONDS=60
CHESS_CRAWL_EXPORT_DOWNLOAD_SECONDS=300
CHESS_CRAWL_EXPORT_WORKSPACE_SLOTS=2
CHESS_CRAWL_EXPORT_OUTSTANDING_SPOOLS=4
CHESS_CRAWL_EXPORT_OUTSTANDING_BYTES=268435456
# A workspace must leave capacity for at least one other full-sized export.
CHESS_CRAWL_EXPORT_WORKSPACE_OUTSTANDING_SPOOLS=2
CHESS_CRAWL_EXPORT_WORKSPACE_OUTSTANDING_BYTES=134217728
